#include "PiloAutoSyncRsc.h"
#ifdef JAPANESE_LAUNCHER
HEX "tAIN" ID 1000
    0x8E 0xA9 0x93 0xAE 0x48 0x6F 0x74 0x53 0x79 0x6E 0x63 0x00
#else
APPLICATIONICONNAME ID 1000 "AutoHotSync"
#endif
ICON ID 1000
BEGIN
    BITMAP "icons/autosync_large_bw.bmp" BPP 1
    BITMAP "icons/autosync_large_gray.bmp" BPP 2
    BITMAP "icons/autosync_large_gray.bmp" BPP 4
    BITMAP "icons/autosync_large_color.bmp" BPP 8
END
SMALLICON ID 1001
BEGIN
    BITMAP "icons/autosync_small_bw.bmp" BPP 1
    BITMAP "icons/autosync_small_gray.bmp" BPP 2
    BITMAP "icons/autosync_small_gray.bmp" BPP 4
    BITMAP "icons/autosync_small_color.bmp" BPP 8
END
VERSION ID 1 "0.1"
#ifdef JAPANESE_LAUNCHER
FORM ID MainForm AT (0 0 160 160) NOSAVEBEHIND NOFRAME
BEGIN
 TITLE "\x8E\xA9\x93\xAE\x48\x6F\x74\x53\x79\x6E\x63"
 CHECKBOX "\x97\x4C\x8C\xF8" ID EnableControl AT (4 15 AUTO AUTO)
 PUSHBUTTON "\x93\xFA" ID 1010 AT (3 30 21 12) GROUP 1
 PUSHBUTTON "\x8C\x8E" ID 1011 AT (25 30 21 12) GROUP 1
 PUSHBUTTON "\x89\xCE" ID 1012 AT (47 30 21 12) GROUP 1
 PUSHBUTTON "\x90\x85" ID 1013 AT (69 30 21 12) GROUP 1
 PUSHBUTTON "\x96\xD8" ID 1014 AT (91 30 21 12) GROUP 1
 PUSHBUTTON "\x8B\xE0" ID 1015 AT (113 30 21 12) GROUP 1
 PUSHBUTTON "\x93\x79" ID 1016 AT (135 30 21 12) GROUP 1
 LIST "" ID TimeList AT (5 47 65 55) VISIBLEITEMS 5
 BUTTON "+" ID AddControl AT (77 47 30 14)
 BUTTON "-" ID DeleteControl AT (112 47 30 14)
 BUTTON "\x82\xD9\x82\xA9\x82\xCC\x97\x6A\x93\xFA\x82\xD6\x81\x63" ID CopyControl AT (75 68 80 14)
 LABEL "                              " ID NextLabel AT (4 125)
END
FORM ID CopyForm AT (5 10 150 140) FRAME MODAL SAVEBEHIND USABLE
BEGIN
 TITLE "\x83\x52\x83\x73\x81\x5B\x90\xE6\x82\xCC\x97\x6A\x93\xFA"
 CHECKBOX "\x93\xFA" ID 1110 AT (8 19 AUTO AUTO)
 CHECKBOX "\x8C\x8E" ID 1111 AT (76 19 AUTO AUTO)
 CHECKBOX "\x89\xCE" ID 1112 AT (8 40 AUTO AUTO)
 CHECKBOX "\x90\x85" ID 1113 AT (76 40 AUTO AUTO)
 CHECKBOX "\x96\xD8" ID 1114 AT (8 61 AUTO AUTO)
 CHECKBOX "\x8B\xE0" ID 1115 AT (76 61 AUTO AUTO)
 CHECKBOX "\x93\x79" ID 1116 AT (8 82 AUTO AUTO)
 BUTTON "OK" ID CopyOK AT (15 116 50 14)
 BUTTON "\x8E\xE6\x8F\xC1" ID CopyCancel AT (80 116 55 14)
END
ALERT ID DuplicateAlert WARNING DEFAULTBUTTON 0
BEGIN
 TITLE "\x8E\xA9\x93\xAE\x48\x6F\x74\x53\x79\x6E\x63"
 MESSAGE "\x93\xAF\x82\xB6\x8E\x9E\x8D\x8F\x82\xAA\x82\xA0\x82\xE8\x82\xDC\x82\xB7"
 BUTTONS "OK"
END
ALERT ID FullAlert WARNING DEFAULTBUTTON 0
BEGIN
 TITLE "\x8E\xA9\x93\xAE\x48\x6F\x74\x53\x79\x6E\x63"
 MESSAGE "\x31\x97\x6A\x93\xFA\x82\xC9\x38\x8C\x8F\x82\xDC\x82\xC5\x82\xC5\x82\xB7"
 BUTTONS "OK"
END
#else
FORM ID MainForm AT (0 0 160 160) NOSAVEBEHIND NOFRAME
BEGIN
 TITLE "AutoHotSync"
 CHECKBOX "Enabled" ID EnableControl AT (4 15 AUTO AUTO)
 PUSHBUTTON "Sun" ID 1010 AT (3 30 21 12) GROUP 1
 PUSHBUTTON "Mon" ID 1011 AT (25 30 21 12) GROUP 1
 PUSHBUTTON "Tue" ID 1012 AT (47 30 21 12) GROUP 1
 PUSHBUTTON "Wed" ID 1013 AT (69 30 21 12) GROUP 1
 PUSHBUTTON "Thu" ID 1014 AT (91 30 21 12) GROUP 1
 PUSHBUTTON "Fri" ID 1015 AT (113 30 21 12) GROUP 1
 PUSHBUTTON "Sat" ID 1016 AT (135 30 21 12) GROUP 1
 LIST "" ID TimeList AT (5 47 65 55) VISIBLEITEMS 5
 BUTTON "+" ID AddControl AT (77 47 30 14)
 BUTTON "-" ID DeleteControl AT (112 47 30 14)
 BUTTON "Copy to..." ID CopyControl AT (75 68 80 14)
 LABEL "                              " ID NextLabel AT (4 125)
END
FORM ID CopyForm AT (5 10 150 140) FRAME MODAL SAVEBEHIND USABLE
BEGIN
 TITLE "Copy to"
 CHECKBOX "Sun" ID 1110 AT (8 19 AUTO AUTO)
 CHECKBOX "Mon" ID 1111 AT (76 19 AUTO AUTO)
 CHECKBOX "Tue" ID 1112 AT (8 40 AUTO AUTO)
 CHECKBOX "Wed" ID 1113 AT (76 40 AUTO AUTO)
 CHECKBOX "Thu" ID 1114 AT (8 61 AUTO AUTO)
 CHECKBOX "Fri" ID 1115 AT (76 61 AUTO AUTO)
 CHECKBOX "Sat" ID 1116 AT (8 82 AUTO AUTO)
 BUTTON "OK" ID CopyOK AT (15 116 50 14)
 BUTTON "Cancel" ID CopyCancel AT (80 116 55 14)
END
ALERT ID DuplicateAlert WARNING DEFAULTBUTTON 0
BEGIN
 TITLE "AutoHotSync"
 MESSAGE "Time already exists"
 BUTTONS "OK"
END
ALERT ID FullAlert WARNING DEFAULTBUTTON 0
BEGIN
 TITLE "AutoHotSync"
 MESSAGE "Maximum 8 times per day"
 BUTTONS "OK"
END
#endif

ALERT ID RomIncompatibleAlert ERROR DEFAULTBUTTON 0
BEGIN
 TITLE "Palm OS 3.1 required"
 MESSAGE "PiloAutoSync needs Palm OS 3.1 or later."
 BUTTONS "OK"
END
